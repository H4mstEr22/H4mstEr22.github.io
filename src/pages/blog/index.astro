---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostList from '../../components/PostList.astro';
import SectionBar from '../../components/SectionBar.astro';
import { SECTIONS } from '../../site.config';
import { getPosts, getTags, fmtDate } from '../../lib/posts';

const posts = await getPosts();
const tags = getTags(posts);
const chars = posts.reduce((n, p) => n + p.chars, 0);
---

<Base title="日志 Logs" description={`H4mstEr22 的博客：${SECTIONS.map((s) => s.cn).join('、')}。`}>
  <PageHead
    index="SEC.00"
    en="Logs"
    cn="全部日志"
    desc="所有板块的日志，按时间倒序排列，最新的在最上面。"
    stats={[
      { k: 'Entries / 篇数', v: posts.length },
      { k: 'Sectors / 板块', v: SECTIONS.length },
      { k: 'Chars / 字数', v: chars.toLocaleString('en-US') },
      { k: 'Last / 最近更新', v: posts[0] ? fmtDate(posts[0].data.pubDate) : '—' },
    ]}
  />
  <PostList posts={posts} tags={tags}>
    <SectionBar />
  </PostList>
</Base>
