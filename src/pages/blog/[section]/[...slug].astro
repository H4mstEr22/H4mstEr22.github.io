---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Barcode from '../../../components/Barcode.astro';
import ReviewCard from '../../../components/ReviewCard.astro';
import { getPosts, fmtDate, postHref, sectionHref, tagHref } from '../../../lib/posts';
import { canEncode } from '../../../lib/code128';
import '../../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // 上一篇 / 下一篇只在同一板块里翻
    const siblings = posts.filter((p) => p.section.id === post.section.id);
    const i = siblings.indexOf(post);
    return {
      params: { section: post.section.id, slug: post.id.slice(post.section.id.length + 1) },
      props: { post, newer: siblings[i - 1], older: siblings[i + 1] },
    };
  });
}

const { post, newer, older } = Astro.props;
const { section } = post;
const { title, description, pubDate, updatedDate, tags, draft, review } = post.data;
const { Content, headings } = await render(post);
/** 条码编码文件名；文件名含中文等 Code 128 不支持的字符时改用日志编号 */
const barcodeValue = canEncode(post.file) ? post.file : post.logNo;
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
let h2 = 0;
const tocItems = toc.map((h) => ({ ...h, no: h.depth === 2 ? String(++h2).padStart(2, '0') : '' }));
---

<Base title={title} description={description} type="article">
  <article class="post">
    <header class="post-head container">
      <nav class="crumbs label" aria-label="面包屑">
        <a href="/">Home</a><span>/</span><a href="/blog/">Logs</a><span>/</span><a href={sectionHref(section)}>{section.en}</a><span>/</span><span class="cur">{post.logNo}</span>
      </nav>
      <div class="meta">
        <span class="m-no mono">{post.logNo}</span>
        {draft && <span class="m-draft mono">DRAFT</span>}
        <a class="m-item m-sec" href={sectionHref(section)}><span class="label">Sector</span><span>{section.cn}</span></a>
        <span class="m-item"><span class="label">Date</span><time class="mono" datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time></span>
        {
          updatedDate && (
            <span class="m-item">
              <span class="label">Updated</span>
              <time class="mono" datetime={updatedDate.toISOString()}>{fmtDate(updatedDate)}</time>
            </span>
          )
        }
        <span class="m-item"><span class="label">Read</span><span class="mono">≈ {post.minutes} min</span></span>
        <span class="m-item"><span class="label">Chars</span><span class="mono">{post.chars.toLocaleString('en-US')}</span></span>
      </div>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
      {
        tags.length > 0 && (
          <div class="chips">
            {tags.map((t) => (
              <a class="chip" href={tagHref(t)}>
                #{t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="container"><div class="ticks"></div></div>

    <div class:list={['container', 'post-grid', { 'no-toc': tocItems.length === 0 }]}>
      <div class="post-main">
        {review && <ReviewCard review={review} />}
        <div class="prose">
          <Content />
        </div>
      </div>
      {
        tocItems.length > 0 && (
          <aside class="toc" aria-label="目录">
            <div class="toc-inner">
              <p class="label toc-head">Index / 目录</p>
              <ol>
                {tocItems.map((h) => (
                  <li class:list={[`d${h.depth}`]}>
                    <a href={`#${h.slug}`} data-toc={h.slug}>
                      {h.no && <span class="mono toc-no">{h.no}</span>}
                      <span>{h.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
              <a class="label toc-top" href="#top">↑ Top</a>
            </div>
          </aside>
        )
      }
    </div>

    <footer class="container post-end">
      <div class="end-mark">
        <span class="label">End of log / 日志结束</span>
        <Barcode value={barcodeValue} stretch height={18} class="end-code" />
        <span class="mono end-no">{post.logNo}</span>
      </div>
      <nav class="post-nav" aria-label="相邻文章">
        {
          older ? (
            <a class="pn prev" href={postHref(older)}>
              <span class="label">← Older / 上一篇</span>
              <span class="pn-title">{older.data.title}</span>
            </a>
          ) : (
            <span class="pn pn-empty label">— 已是{section.cn}的第一篇 —</span>
          )
        }
        {
          newer ? (
            <a class="pn next" href={postHref(newer)}>
              <span class="label">Newer / 下一篇 →</span>
              <span class="pn-title">{newer.data.title}</span>
            </a>
          ) : (
            <span class="pn pn-empty label">— 已是{section.cn}的最新一篇 —</span>
          )
        }
      </nav>
    </footer>
  </article>
</Base>

<script>
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
  if (links.size && 'IntersectionObserver' in window) {
    const visible = new Set<string>();
    const order = [...links.keys()];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        const current = order.find((id) => visible.has(id));
        if (!current) return;
        links.forEach((a, id) => a.classList.toggle('is-active', id === current));
        // 目录在侧栏里滚动时，让当前条目保持可见
        const box = document.querySelector<HTMLElement>('.toc-inner');
        const a = links.get(current)!;
        if (box && box.scrollHeight > box.clientHeight) {
          const top = a.offsetTop;
          if (top < box.scrollTop || top + a.offsetHeight > box.scrollTop + box.clientHeight) {
            box.scrollTo({ top: top - box.clientHeight / 3 });
          }
        }
      },
      { rootMargin: '-80px 0px -65% 0px' },
    );
    order.forEach((id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
</script>

<style>
  .post-head {
    padding-top: clamp(36px, 6vw, 72px);
    padding-bottom: 28px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
    color: var(--fg-faint);
  }
  .crumbs a:hover {
    color: var(--fg);
    box-shadow: inset 0 -4px 0 var(--accent);
  }
  .crumbs .cur {
    color: var(--fg);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    margin-bottom: 22px;
    border: 1px solid var(--line-mid);
    width: fit-content;
    max-width: 100%;
    animation: rise 0.6s var(--ease) both;
  }
  .m-no {
    display: grid;
    place-items: center;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 700;
    background: var(--accent);
    color: var(--on-accent);
  }
  .m-draft {
    display: grid;
    place-items: center;
    padding: 6px 10px;
    font-size: 12px;
    background: var(--alert);
    color: #fff;
  }
  .m-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5px 14px;
    border-left: 1px solid var(--line-mid);
    line-height: 1.3;
  }
  .m-item .label {
    font-size: 9px;
    color: var(--fg-faint);
  }
  .m-item .mono {
    font-size: 13px;
  }
  .m-sec {
    font-size: 13px;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .m-sec:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .m-sec:hover .label {
    color: var(--on-accent);
  }
  .post-title {
    max-width: 920px;
    font-size: clamp(32px, 5vw, 54px);
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: 0.01em;
    animation: rise 0.7s var(--ease) 0.06s both;
  }
  .post-desc {
    max-width: 720px;
    margin: 16px 0 22px;
    font-size: 18px;
    color: var(--fg-muted);
    animation: rise 0.7s var(--ease) 0.12s both;
  }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 64px;
    padding-top: 44px;
  }
  .toc {
    position: relative;
  }
  .toc-inner {
    position: sticky;
    top: calc(var(--header-h) + 28px);
    /* 目录太长时在侧栏里滚动；竖线画成背景，避免被滚动区域裁掉高亮条 */
    max-height: calc(100vh - var(--header-h) - 56px);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding-left: 19px;
    background: linear-gradient(var(--line-mid), var(--line-mid)) left top / 1px 100% no-repeat;
  }
  .toc-head {
    margin-bottom: 12px;
    color: var(--fg);
  }
  .toc ol {
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .toc a {
    position: relative;
    display: flex;
    gap: 8px;
    padding: 4px 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--fg-muted);
    transition: color 0.2s;
  }
  .toc .d3 a {
    padding-left: 26px;
    font-size: 13px;
  }
  .toc a:hover,
  .toc a.is-active {
    color: var(--fg);
  }
  .toc a.is-active::before {
    content: '';
    position: absolute;
    left: -19px;
    top: 4px;
    bottom: 4px;
    width: 3px;
    background: var(--accent);
  }
  .toc-no {
    flex: none;
    font-size: 11px;
    padding-top: 2px;
    color: var(--fg-faint);
  }
  .toc a.is-active .toc-no {
    color: var(--fg);
  }
  .toc-top {
    display: inline-block;
    margin-top: 18px;
    color: var(--fg-faint);
  }
  .toc-top:hover {
    color: var(--fg);
  }

  .post-end {
    margin-top: 72px;
  }
  .end-mark {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-block: 1px solid var(--line-strong);
  }
  .end-mark :global(.end-code) {
    flex: 1;
    min-width: 0;
    color: var(--fg);
    opacity: 0.55;
  }
  @media (max-width: 760px) {
    /* 窄屏时条码单独占一行，避免被压得太细 */
    .end-mark {
      flex-wrap: wrap;
      justify-content: space-between;
    }
    .end-mark :global(.end-code) {
      order: 3;
      flex-basis: 100%;
    }
  }
  .end-no {
    font-size: 13px;
    font-weight: 700;
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--bg-elev);
    border: 1px solid var(--line-mid);
    transition: background-color 0.25s var(--ease), color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .pn.next {
    text-align: right;
  }
  a.pn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  a.pn:hover .label {
    color: var(--on-accent);
  }
  .pn-title {
    font-size: 17px;
    font-weight: 600;
  }
  .pn-empty {
    justify-content: center;
    align-items: center;
    background: transparent;
    border-style: dashed;
    color: var(--fg-faint);
  }

  @media (max-width: 1080px) {
    .post-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .pn.next {
      text-align: left;
    }
  }
</style>
