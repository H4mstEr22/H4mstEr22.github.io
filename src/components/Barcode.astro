---
/**
 * 真·Code 128 条码，可被扫码枪 / 手机扫码识别。
 * 始终是「浅底深条」的标签样式：反色条码多数扫码软件读不出来。
 *
 * 站内用法：
 *   首页身份卡  → 你的 ID（SITE.author）
 *   档案卡底部  → 档案同步日期（构建日期，YYYYMMDD）
 *   页脚        → 终端编号（SITE.terminalId）
 *   文章末尾    → 文章文件名（post.id）
 */
import { encodeCode128 } from '../lib/code128';

interface Props {
  value: string;
  /** 最细条的宽度（px）。屏幕上扫码建议 ≥ 2 */
  module?: number;
  height?: number;
  /** 条码下方的可读文字，默认就是编码内容；false 不显示 */
  text?: string | false;
  class?: string;
}
const { value, module = 2, height = 34, text = value, class: cls } = Astro.props;
const { bars, width } = encodeCode128(value);
---

<figure class:list={['barcode', cls]} style={`--bc-w:${width * module}px`}>
  <svg
    width={width * module}
    height={height}
    viewBox={`0 0 ${width} ${height}`}
    preserveAspectRatio="none"
    shape-rendering="crispEdges"
    role="img"
    aria-label={`Code 128 条形码：${value}`}
  >
    {bars.map((b) => <rect x={b.x} y="0" width={b.w} height={height} />)}
  </svg>
  {text !== false && <figcaption>{text}</figcaption>}
</figure>

<style>
  .barcode {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    width: var(--bc-w);
    max-width: 100%;
    margin: 0;
    padding: 6px 0 4px;
    background: #f4f4ef;
    box-shadow: inset 0 0 0 1px rgba(18, 19, 21, 0.1);
  }
  svg {
    width: 100%;
    max-width: 100%;
    fill: #121315;
  }
  figcaption {
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 0.18em;
    color: #121315;
  }
</style>
