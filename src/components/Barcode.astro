---
/**
 * 彩蛋：看起来是装饰条码，其实是真的 Code 128，扫码能读出内容。
 * 条纹跟随主题色（浅色主题下最容易扫出来）。
 *
 * 各处藏的内容：
 *   首页身份卡  → 你的 ID（SITE.author）
 *   档案卡底部  → 档案同步日期（构建日期，YYYYMMDD）
 *   页脚        → 终端编号（SITE.terminalId）
 *   文章末尾    → 文章文件名（post.file，不含板块文件夹）
 */
import { encodeCode128 } from '../lib/code128';

interface Props {
  value: string;
  /** 最细条的宽度（px） */
  module?: number;
  height?: number;
  /** 横向拉伸填满容器（条码按比例变宽，仍然可扫） */
  stretch?: boolean;
  class?: string;
}
const { value, module = 2, height = 26, stretch = false, class: cls } = Astro.props;
const { bars, width } = encodeCode128(value);
---

<svg
  class:list={['barcode', cls, { stretch }]}
  width={stretch ? undefined : width * module}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  preserveAspectRatio="none"
  shape-rendering={stretch ? undefined : 'crispEdges'}
  aria-hidden="true"
>
  {bars.map((b) => <rect x={b.x} y="0" width={b.w} height={height} />)}
</svg>

<style>
  .barcode {
    flex: none;
    max-width: 100%;
    fill: currentColor;
  }
  .barcode.stretch {
    width: 100%;
  }
</style>
