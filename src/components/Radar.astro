---
/** 六维能力雷达图（单一序列，无需图例；每个轴直接标注数值） */
interface Ability {
  en: string;
  cn: string;
  level: number;
}
interface Props {
  abilities: Ability[];
}
const { abilities } = Astro.props;

const W = 400;
const H = 340;
const cx = W / 2;
const cy = H / 2;
const R = 110;
const n = abilities.length;

const ang = (i: number) => (-90 + (360 / n) * i) * (Math.PI / 180);
const pt = (r: number, i: number) => [cx + r * Math.cos(ang(i)), cy + r * Math.sin(ang(i))] as const;
const poly = (r: number) => abilities.map((_, i) => pt(r, i).map((v) => v.toFixed(1)).join(',')).join(' ');

const grade =(v: number) => (v >= 90 ? 'S' : v >= 80 ? 'A' : v >= 65 ? 'B' : v >= 50 ? 'C' : 'D');

const shape = abilities.map((a, i) => pt((R * Math.max(0, Math.min(100, a.level))) / 100, i));
const labels = abilities.map((a, i) => {
  const [x, y] = pt(R + 26, i);
  const c = Math.cos(ang(i));
  const anchor = Math.abs(c) < 0.1 ? 'middle' : c > 0 ? 'start' : 'end';
  const s = Math.sin(ang(i));
  const dy = s < -0.9 ? -14 : s > 0.9 ? 6 : -4;
  return { ...a, x, y: y + dy, anchor };
});
const summary = abilities.map((a) => `${a.cn} ${a.level}`).join('，');
---

<svg class="radar-svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`能力矩阵：${summary}`}>
  <g class="grid">
    {[0.25, 0.5, 0.75, 1].map((f) => <polygon points={poly(R * f)} class:list={[{ outer: f === 1 }]} />)}
    {
      abilities.map((_, i) => {
        const [x, y] = pt(R, i);
        return <line x1={cx} y1={cy} x2={x} y2={y} />;
      })
    }
  </g>
  <g class="radar-shape">
    <polygon class="shape" points={shape.map((p) => p.map((v) => v.toFixed(1)).join(',')).join(' ')}></polygon>
    {
      shape.map(([x, y], i) => (
        <g class="node">
          <circle cx={x} cy={y} r="14" class="hit">
            <title>
              {abilities[i].cn} {abilities[i].en}：{abilities[i].level}（{grade(abilities[i].level)}）
            </title>
          </circle>
          <rect x={x - 4.5} y={y - 4.5} width="9" height="9" class="mark" />
        </g>
      ))
    }
  </g>
  {
    labels.map((l) => (
      <text x={l.x} y={l.y} text-anchor={l.anchor} class="lbl" aria-hidden="true">
        <tspan class="lbl-en">{l.en}</tspan>
        <tspan x={l.x} dy="15" class="lbl-v">
          {l.cn} · {l.level} · {grade(l.level)}
        </tspan>
      </text>
    ))
  }
</svg>

<style>
  .radar-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid polygon,
  .grid line {
    fill: none;
    stroke: var(--line-mid);
    stroke-width: 1;
  }
  .grid polygon.outer {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }
  .radar-shape {
    transform-box: view-box;
    transform-origin: 200px 170px;
    transition: transform 1.1s var(--ease) 0.25s;
  }
  :global(html.reveal-on .reveal:not(.is-in)) .radar-shape {
    transform: scale(0);
  }
  .shape {
    fill: var(--radar-fill);
    stroke: var(--radar-stroke);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .hit {
    fill: transparent;
    cursor: help;
  }
  .mark {
    fill: var(--bg-elev);
    stroke: var(--radar-stroke);
    stroke-width: 2;
    pointer-events: none;
    transform-box: fill-box;
    transform-origin: center;
    transform: rotate(45deg);
    transition: fill 0.2s;
  }
  .node:hover .mark {
    fill: var(--accent);
  }
  .lbl {
    fill: var(--fg);
  }
  .lbl-en {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
  .lbl-v {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: var(--fg-muted);
  }
</style>
