---
import Logo from './Logo.astro';
import { NAV, SITE } from '../site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" id="top">
  <div class="hazard hazard--thin"></div>
  <div class="bar">
    <div class="container inner">
      <a class="brand" href="/" aria-label={`${SITE.title} 主页`}>
        <Logo class="logo" />
        <span class="brand-text">
          <span class="brand-name display">{SITE.codename}</span>
          <span class="brand-sub label">// Personal Terminal</span>
        </span>
      </a>

      <nav class="nav" aria-label="主导航">
        {
          NAV.map((n, i) => (
            <a
              href={n.href}
              class:list={['nav-link', { 'is-active': isActive(n.href) }]}
              aria-current={isActive(n.href) ? 'page' : undefined}
            >
              <span class="nav-idx mono">0{i + 1}</span>
              <span class="nav-en display">{n.en}</span>
              <span class="nav-cn">{n.cn}</span>
            </a>
          ))
        }
      </nav>

      <div class="tools">
        <span class="clock">
          <span class="label">{SITE.timezoneLabel}</span>
          <span class="mono" data-clock>--:--:--</span>
        </span>
        <button class="theme-btn" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
          <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="8" y="8" width="8" height="8"></rect>
            <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
          </svg>
          <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .bar {
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--header-h);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .brand :global(.logo) {
    transition: transform 0.4s var(--ease);
  }
  .brand:hover :global(.logo) {
    transform: rotate(60deg);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1;
    gap: 4px;
  }
  .brand-name {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    font-size: 9.5px;
    color: var(--fg-faint);
  }

  .nav {
    display: flex;
    margin-left: auto;
    height: 100%;
  }
  .nav-link {
    position: relative;
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    column-gap: 8px;
    align-content: center;
    padding: 0 16px;
    height: 100%;
    color: var(--fg-muted);
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: -1px;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nav-link:hover {
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
  }
  .nav-link.is-active {
    color: var(--fg);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  .nav-idx {
    grid-row: 1 / 3;
    align-self: start;
    padding-top: 3px;
    font-size: 10px;
    color: var(--fg-faint);
  }
  .nav-en {
    font-size: 18px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.06em;
  }
  .nav-cn {
    font-size: 11px;
    line-height: 1.3;
    color: var(--fg-faint);
    letter-spacing: 0.2em;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .clock {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .clock .label {
    font-size: 9px;
    color: var(--fg-faint);
  }
  .theme-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid var(--line-mid);
    cursor: pointer;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .theme-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .i-moon {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .i-moon {
    display: block;
  }

  @media (max-width: 860px) {
    .clock,
    .brand-sub {
      display: none;
    }
    .nav-link {
      padding: 0 12px;
    }
  }
  @media (max-width: 560px) {
    .inner {
      gap: 8px;
    }
    .nav-idx,
    .nav-cn {
      display: none;
    }
    .nav-link {
      padding: 0 9px;
    }
    .nav-en {
      font-size: 16px;
    }
    .brand-name {
      font-size: 19px;
    }
  }
  @media (max-width: 400px) {
    .brand-text {
      display: none;
    }
  }
</style>
