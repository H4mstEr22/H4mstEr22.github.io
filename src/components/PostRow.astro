---
import type { Post } from '../lib/posts';
import { fmtDate } from '../lib/posts';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<a class="post-row" href={`/blog/${post.id}/`}>
  <span class="pr-no mono">{post.logNo}</span>
  <time class="pr-date mono" datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
  <span class="pr-main">
    <span class="pr-title">
      {draft && <span class="pr-draft mono">DRAFT</span>}
      {title}
    </span>
    <span class="pr-desc">{description}</span>
  </span>
  <span class="pr-side">
    <span class="pr-tags mono">{tags.map((t) => `#${t}`).join('  ')}</span>
    <span class="pr-read label">{post.minutes} min</span>
  </span>
  <span class="pr-go" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
  </span>
</a>

<style>
  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 92px 96px minmax(0, 1fr) auto 44px;
    align-items: center;
    gap: 20px;
    padding: 22px 0 22px 18px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.25s var(--ease);
  }
  .post-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 4px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.3s var(--ease);
  }
  .post-row:hover {
    background: color-mix(in srgb, var(--bg-elev) 80%, transparent);
  }
  .post-row:hover::before {
    transform: scaleY(1);
  }
  .pr-no {
    font-size: 12px;
    font-weight: 600;
    color: var(--fg-faint);
  }
  .post-row:hover .pr-no {
    color: var(--fg);
  }
  .pr-date {
    font-size: 13px;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .pr-main {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .pr-title {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.35;
  }
  .pr-draft {
    margin-right: 8px;
    padding: 1px 6px;
    font-size: 10px;
    vertical-align: 3px;
    background: var(--alert);
    color: #fff;
  }
  .pr-desc {
    font-size: 14px;
    color: var(--fg-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pr-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: right;
  }
  .pr-tags {
    font-size: 12px;
    color: var(--fg-muted);
    white-space: pre;
  }
  .pr-read {
    color: var(--fg-faint);
  }
  .pr-go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-mid);
    transition: all 0.25s var(--ease);
  }
  .post-row:hover .pr-go {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateX(4px);
  }
  @media (max-width: 860px) {
    .post-row {
      grid-template-columns: auto 1fr 40px;
      grid-template-areas:
        'no date go'
        'main main go'
        'side side go';
      gap: 8px 14px;
      padding: 18px 0 18px 14px;
    }
    .pr-no {
      grid-area: no;
    }
    .pr-date {
      grid-area: date;
    }
    .pr-main {
      grid-area: main;
    }
    .pr-side {
      grid-area: side;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      text-align: left;
    }
    .pr-go {
      grid-area: go;
      width: 34px;
      height: 34px;
    }
    .pr-desc {
      white-space: normal;
    }
  }
</style>
